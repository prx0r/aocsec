  "_comment": "Copy to gateway.json, replace secrets, chmod 600. Never commit the real file.",
  "tokens": {
    "customer-example": {
      "secret": "GENERATE-32-RANDOM-BYTES-HERE",
      "scopes": ["legislation:read"]
    }
  },
  "backends": {
    "legislation": {
      "command": ["python3", "-m", "legislation.mcp_server"],
